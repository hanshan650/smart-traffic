# ==========================================================================
# .gitignore — 智能交通监测与事故预警平台
# --------------------------------------------------------------------------
# 本仓库**不包含**任何密钥与运行时数据。以下三类必须排除：
#   1. 密钥文件   —— API Key、数据库连接串（泄露会被盗用配额）
#   2. 大体积产物 —— 虚拟环境、依赖包、模型权重（clone 后按需重建）
#   3. 运行时数据 —— 抓帧截图含真实道路画面与时间戳，涉及隐私
# ==========================================================================

# ==========================================================================
# 1. 密钥与环境变量（最高优先级）
# ==========================================================================

# 后端配置：含 AMAP_WEB_KEY（高德 Web 服务 Key）与 MongoDB 连接串
backend/.env

# 各处的本地覆盖文件
*.env.local
.env.*.local

# 证书与凭据
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# 注意：以下文件是**脱敏模板**，必须保留在仓库中，供他人复制后填写
#   backend/.env.example
#   frontend/.env.development

# ==========================================================================
# 2. Python
# ==========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================================================
# 3. Node / 前端
# ==========================================================================
node_modules/
frontend/dist/
frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ==========================================================================
# 4. 模型权重（体积大，clone 后按 README 指引下载）
#    约 6 MB（yolov8n）/ 21 MB（yolov8s），不适合入库
# ==========================================================================
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.mlpackage
*.tflite
# 中断的下载残留
*.part

# ==========================================================================
# 5. 运行时产物
# ==========================================================================

# 抓帧截图：真实道路画面 + 摄像头位置 + 时间戳，涉及隐私，且体积持续增长
backend/static/uploads/*
!backend/static/uploads/.gitkeep

# 会话文件
flask_session/

# 日志
*.log
logs/

# 临时目录（事故分析的抽帧工作区）
backend/static/uploads/_hls_frames/
backend/static/uploads/_temporal/
backend/static/uploads/_yolo_detr/
backend/static/uploads/_model_cmp/
backend/static/uploads/frames_*/

# ==========================================================================
# 6. IDE / 编辑器 / 操作系统
# ==========================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ==========================================================================
# 7. 数据集与标注（如后续引入，同样体积过大）
# ==========================================================================
datasets/
*.zip
*.tar.gz
*.7z
