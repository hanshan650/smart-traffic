# ============================================================
# 智能交通监测与事故预警平台 — 环境变量样例
# 复制为 .env 后按需修改（.env 不入库，切勿提交真实密钥）
#
# 优先级：环境变量 > .env 文件 > 代码内默认值
# 变量名大小写不敏感。以下取值为代码默认值，通常可直接沿用。
# ============================================================

# ---------- 应用 ----------
APP_NAME=smart-traffic
APP_TITLE=智能交通监测与事故预警平台
DEBUG=true
API_PREFIX=/api/v1

# ---------- MongoDB（必需） ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=smart_traffic
# 连接超时（毫秒）。未启动时健康检查标 degraded，但接口仍可用
MONGO_TIMEOUT_MS=3000

# ---------- Redis（可选，未启动时自动降级） ----------
# 未启动不会拖慢接口：内部有 30 秒离线冷却，冷却期内直接跳过。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=traffic:
# 缓存与限流
CACHE_TTL_SNAPSHOT=5
CACHE_TTL_ROAD_HEATMAP=60
# 同一 (事件类型, 摄像头) 的告警限流窗口（秒），避免告警风暴
ALERT_THROTTLE_SECONDS=60

# ---------- 视频源 ----------
# henan    = 河南高速云视频（默认，可用）
# shanghai = 上海城市道路监控（仅保留接入位，无公开视频接口）
VIDEO_SOURCE=henan

# 河南高速云平台
HNGS_API_BASE=https://weixin.hngscloud.com
HNGS_REFERER=https://weixin.hngscloud.com/
# 部分接口会校验请求头，缺失时可能返回非视频内容
HNGS_USER_AGENT=Mozilla/5.0
HNGS_DEFAULT_CAMERA=1324629868805103618
HNGS_REQUEST_TIMEOUT=10
# 取流参数，通常无需修改
HNGS_VIDEO_TYPE=2
HNGS_VIDEO_RATE=0
# 摄像头检索视野（默认河南全省）
HNGS_VIEWPORT_NE=116.5,36.5
HNGS_VIEWPORT_SW=110.5,31.0
HNGS_VIEWPORT_ZOOM=8

# ---------- 抽帧 ----------
# 留空自动探测：环境变量 → PATH → 常见安装路径 → 项目目录
# 未安装时自动降级为 HLS 分片离线解码，功能不受影响
FFMPEG_PATH=
FRAME_CAPTURE_TIMEOUT=20
# 抓帧产物小于该字节数视为失败（防止把错误页面当图片解码）
FRAME_MIN_BYTES=1024

# ---------- YOLO ----------
# n=最小最快；s=精度更高。上游画面分辨率低、目标小，实测 s 明显优于 n。
YOLO_MODEL_PATH=yolov8s.pt
YOLO_CONFIDENCE=0.25
# 推理输入边长。低分辨率源必须放大推理，否则远处车辆会被直接漏掉。
# 实测同一帧：640 检出 1 个目标，960 检出 7 个。
# 变量名须与 config.py 字段 yolo_image_size 一致（也兼容 YOLO_IMGSZ）
YOLO_IMAGE_SIZE=960
# 权重文件搜索目录（相对 backend/）。权重不入库，需自行下载。
YOLO_MODEL_DIRS=.,../traffic_monitor

# ---------- 预警阈值（帧内车辆数） ----------
TRAFFIC_LIGHT_THRESHOLD=15
TRAFFIC_MODERATE_THRESHOLD=30
TRAFFIC_HEAVY_THRESHOLD=50

# ---------- 跨域 ----------
# 真机通过局域网 IP 访问时，需把该 IP:5173 一并加进来（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 上传 ----------
UPLOAD_DIR=static/uploads
MAX_UPLOAD_MB=100

# ---------- 高德地图 ----------
# 需在 https://console.amap.com/ 创建**两个不同类型**的 Key：
#   AMAP_JS_KEY          类型选「Web端(JS API)」  —— 前端地图渲染
#   AMAP_WEB_KEY         类型选「Web服务」        —— 后端地理编码/路径规划
#   AMAP_JS_SECURITY_CODE 「安全密钥」，与 JS Key 配对生成
# JS API 2.0 强制要求安全密钥，缺失时地图会报 INVALID_USER_SCODE
# JS Key 需在控制台绑定域名（本地开发填 localhost 与 127.0.0.1）
AMAP_JS_KEY=
AMAP_WEB_KEY=
AMAP_JS_SECURITY_CODE=
# 路网默认中心点（上海）
SHANGHAI_CENTER_LNG=121.4737
SHANGHAI_CENTER_LAT=31.2304

# ---------- 警情上报 ----------
# mock     = 模拟交警平台（默认，可跑通全流程）
# shanghai = 上海交警平台（仅保留接入位，无公开接口）
REPORT_REPORTER=mock
# 模拟适配器的人为失败率，用于验证失败重试与提示。0 = 不失败
REPORT_MOCK_FAILURE_RATE=0.0

# ---------- 持续检测（违停监控） ----------
# 服务启动时是否自动开始巡检。默认关闭 —— 巡检持续占用 CPU，
# 应当由使用者显式开启，而不是启动服务就默默跑起来。
SURVEILLANCE_ENABLED=false
# 巡检摄像头列表（逗号分隔）。留空则使用当前视频源的默认摄像头。
SURVEILLANCE_CAMERAS=
# 轮次间隔（秒）。一轮 = 连续抓 N 帧并分析。
# 不宜过小：单帧推理约 200ms，间隔太小会让 CPU 持续饱和。
SURVEILLANCE_INTERVAL=15
# 每轮抓取的帧数。帧数越多跟踪越稳，但一轮耗时越长。
SURVEILLANCE_FRAME_COUNT=20
# 单轮超时（秒），超时后跳过本轮而不阻塞后续轮次
SURVEILLANCE_ROUND_TIMEOUT=120

# 静止判定阈值（秒）。需求给定：非可停车地点静止超过 30 秒即告警
STALL_SECONDS=30.0
# 静止判定的位移阈值（归一化坐标）。约 3.5 像素，略高于检测框抖动
STALL_DISPLACEMENT=0.01
# 同步静止占比达到该值即判为拥堵排队（抑制违停告警）
STALL_CROWD_RATIO=0.6
# 判定为异常所需的最低综合得分
STALL_SCORE_THRESHOLD=0.60
# 统计「同步静止车辆数」时的最短静止时长（秒）。
# 不要设为 0：只要两帧间位移小于阈值就会得到 >0 的时长，
# 设 0 会把所有慢速行驶的车都算成静止，使拥堵抑制误触发。
STALL_COUNT_MIN_STATIONARY=2.0
# 同一目标重复告警的冷却时间（秒）
STALL_ALERT_COOLDOWN=300
# 观测新鲜度上限（秒）。超过该时长无新观测的轨迹不再参与判定
STALL_OBSERVATION_GAP=45.0

# 场景文字（可停车场所）识别通道：keyword（默认，匹配点位名称）| ocr
SURVEILLANCE_TEXT=keyword
# 车牌识别通道：none（默认，未接入）| mock（演示）| official（正式）
# 当前分辨率下车牌字符高不足 1px，正式识别需先更换视频源，
# 详见 docs/车牌识别可行性.md
SURVEILLANCE_PLATE_ENGINE=none
# 车主信息查询通道：none（默认，未接入）| mock（演示）| official（正式）
# 正式接入需走政务专网，调用会强制留痕审计
SURVEILLANCE_OWNER_PROVIDER=none

# ---------- 民众端（公开接口） ----------
# 民众上报的频率上限（每条 client_key）。开放入口必然会被滥用，
# 但限制也不能太紧 —— 真实事故发生时可能多人同时上报，
# 卡死上报通道比收到几条重复信息更糟。
CITIZEN_REPORT_RATE_LIMIT=10
# 频率统计的滑动窗口（小时）
CITIZEN_REPORT_WINDOW_HOURS=1
# 描述与联系方式的长度上限
CITIZEN_REPORT_MAX_DESCRIPTION=500
CITIZEN_REPORT_MAX_CONTACT=100
# 民众上报转为正式事件时的置信度。
# 低于 AI 识别（通常 0.8+）—— 它经过人工核实但缺少算法证据链，
# 保留这个差异可以让下游区分事件来源。
CITIZEN_REPORT_CONFIDENCE=0.7
# 路况公开接口一次最多返回的事件数
PUBLIC_TRAFFIC_LIMIT=100

# ---------- 演示数据 ----------
# 为一件事服务：没接上真实数据源时也能看到「行进视角」的完整效果。
# 数据存在独立集合（demo_citizen_events），不写进 events。
#
# 注意它只是「允许提供」，不等于「一定提供」 —— 真正的判据是
# 「events 集合里有没有真实事件」。有了真实数据就自动失效，
# 不需要谁记得回来关这个开关。
#
# 默认开启是为了方便答辩演示；生产部署应设为 false。
CITIZEN_DEMO_ENABLED=true
