{
  "name": "smart-traffic-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "verify:route": "esbuild src/utils/geo.ts --bundle --format=esm --alias:@=./src --outfile=scripts/.tmp/geo.mjs --log-level=error && esbuild src/utils/route.ts --bundle --format=esm --alias:@=./src --outfile=scripts/.tmp/route.mjs --log-level=error && node scripts/verify_route.mjs",
    "verify:pwa": "..\\backend\\.venv\\Scripts\\python.exe scripts\\verify_pwa.py"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "axios": "^1.7.9",
    "hls.js": "^1.5.18",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^2.2.0"
  }
}
